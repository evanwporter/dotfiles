# Traditional standalone desktop-shell components.
exec_always --no-startup-id sh -c "pkill -x mako; pkill -x swaync; exec swaync"
exec_always --no-startup-id sh -c "pkill -x .waybar-wrapped; while pgrep -x .waybar-wrapped >/dev/null; do sleep 0.1; done; exec waybar"
exec_always --no-startup-id sh -c "pkill -x nm-applet || true"
