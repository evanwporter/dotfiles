# Start Noctalia only when its NixOS module is enabled.
exec_always --no-startup-id noctalia -d
bindsym $mod+space exec --no-startup-id noctalia msg panel-toggle launcher

# Noctalia provides the lock screen; Swayidle still handles idle and DPMS.
exec --no-startup-id swayidle -w timeout 300 'noctalia msg session lock' timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' before-sleep 'noctalia msg session lock'
