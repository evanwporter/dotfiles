# Traditional standalone desktop-shell components.
exec --no-startup-id mako
exec_always --no-startup-id sh -c "pkill -x .waybar-wrapped; while pgrep -x .waybar-wrapped >/dev/null; do sleep 0.1; done; exec waybar"
exec --no-startup-id nm-applet --indicator

bindsym $mod+space exec --no-startup-id fuzzel

# Swaylock provides the lock screen in classic mode.
exec --no-startup-id swayidle -w timeout 300 'swaylock -f -c 303446' timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' before-sleep 'swaylock -f -c 303446'
